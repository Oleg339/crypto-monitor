# ===== Bybit API =====
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
# Set to true to use testnet endpoints
BYBIT_TESTNET=false

# ===== Database (TimescaleDB / PostgreSQL) =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crypto_monitor?sslmode=disable

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Telegram Alerts =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===== Risk Management =====
# Total portfolio capital in USD
TOTAL_CAPITAL=1400
# Percentage of capital to risk per trade (e.g. 1 = 1%)
RISK_PER_TRADE_PCT=1.0
# Maximum number of concurrent open positions
MAX_POSITIONS=5
# Minimum risk-to-reward ratio required to send a signal
MIN_RR_RATIO=1.5

# ===== Symbols and Intervals =====
# Comma-separated list of trading pairs to monitor
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,AAVEUSDT,AVAXUSDT,DOTUSDT,LINKUSDT,MATICUSDT,UNIUSDT
# Candle intervals: 60=1H, 240=4H, D=Daily
INTERVALS=60,240,D
